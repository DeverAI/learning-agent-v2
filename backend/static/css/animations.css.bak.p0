/* ═══════════════════════════════════════════════════
   Animations CSS — 增量动画层（纯追加，不覆盖既有样式）
   依赖 theme.css 的 CSS 变量
   安全设计：隐藏态仅在 <html class="js"> 下武装，
   无 JS / motion.js 未加载时所有内容默认可见
   ═══════════════════════════════════════════════════ */

/* ── 新 keyframes（theme.css 未定义的） ── */
@keyframes dotBounce{0%,80%,100%{transform:translateY(0);opacity:.4}40%{transform:translateY(-5px);opacity:1}}
@keyframes pulseDot{0%,100%{box-shadow:0 0 0 0 var(--dot-glow,var(--accent-glow))}70%{box-shadow:0 0 0 7px transparent}}
@keyframes popIn{0%{opacity:0;transform:scale(.6)}70%{transform:scale(1.05)}100%{opacity:1;transform:scale(1)}}
@keyframes shakeX{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-6px)}40%,80%{transform:translateX(6px)}}

/* ═══ 1. 滚动显现（motion.js 进入视口时加 .revealed，动画后移除类） ═══ */
.js .reveal{opacity:0;transform:translateY(18px);
  transition:opacity .55s cubic-bezier(.22,.61,.36,1),transform .55s cubic-bezier(.22,.61,.36,1);
  transition-delay:var(--d,0ms)}
.js .reveal.reveal-left{transform:translateX(-22px)}
.js .reveal.reveal-right{transform:translateX(22px)}
.js .reveal.reveal-scale{transform:scale(.92)}
/* revealed 规则置于变体之后确保覆盖；动画结束后 JS 移除全部 reveal 类，
   避免残留规则压制 hover transform（如 .stat-card:hover）；
   transition-delay 保留 var(--d)，否则入场延迟会被 after 态归零 */
.js .reveal.revealed{opacity:1;transform:none;transition-delay:var(--d,0ms)}

/* ═══ 2. 级联入场（motion.js 给子元素注入 --i，动画后移除类） ═══ */
.js .stagger>*{opacity:0;transform:translateY(14px);
  transition:opacity .45s cubic-bezier(.22,.61,.36,1),transform .45s cubic-bezier(.22,.61,.36,1);
  transition-delay:calc(var(--i,0)*60ms)}
.js .stagger.stagger-on>*{opacity:1;transform:none}

/* ═══ 3. 列表项入场（动态插入的行元素手动加此类） ═══ */
.list-item-in{animation:fadeInUp .4s cubic-bezier(.22,.61,.36,1) both}

/* ═══ 4. 数字滚动（motion.js 驱动，CSS 仅保证等宽防抖动） ═══ */
.count-up{font-variant-numeric:tabular-nums}

/* ═══ 5. 聊天输入指示（三点弹跳） ═══ */
.typing-dots{display:inline-flex;gap:4px;align-items:center;padding:4px 2px}
.typing-dots i{width:6px;height:6px;border-radius:50%;background:var(--text3);
  animation:dotBounce 1.2s ease-in-out infinite}
.typing-dots i:nth-child(2){animation-delay:.15s}
.typing-dots i:nth-child(3){animation-delay:.3s}

/* ═══ 6. 状态呼吸点（在线/处理中指示） ═══ */
.pulse-dot{display:inline-block;width:8px;height:8px;border-radius:50%;
  --dot-glow:var(--accent-glow);
  background:var(--accent);animation:pulseDot 1.8s ease-out infinite}
.pulse-dot.ok{background:var(--ok);--dot-glow:color-mix(in srgb,var(--ok) 40%,transparent)}
.pulse-dot.warn{background:var(--warn);--dot-glow:color-mix(in srgb,var(--warn) 40%,transparent)}
.pulse-dot.err{background:var(--err);--dot-glow:color-mix(in srgb,var(--err) 40%,transparent)}

/* ═══ 7. 骨架→内容淡入切换 ═══ */
.skeleton-fade{animation:fadeIn .4s ease both}

/* ═══ 8. 弹出强调（徽章/通知出现） ═══ */
.pop-in{animation:popIn .35s cubic-bezier(.22,.61,.36,1) both}

/* ═══ 9. 表单校验失败抖动 ═══ */
/* 重复使用需先移除类再重加：el.classList.remove('shake');void el.offsetWidth;el.classList.add('shake') */
.shake{animation:shakeX .4s ease both}

/* ═══ 10. 卡片微倾斜悬浮（不与 .stat-card 同元素混用，改包父元素） ═══ */
.tilt-hover{transition:transform .3s cubic-bezier(.22,.61,.36,1),box-shadow .3s ease}
.tilt-hover:hover{transform:translateY(-4px) rotate(.4deg);box-shadow:var(--shadow-lg)}

/* ═══ 11. 图片/SVG 载入淡入 ═══ */
.js img.fade-load{opacity:0;transition:opacity .5s ease}
.js img.fade-load.loaded{opacity:1}

/* ═══ 12. JS 涟漪启用时，关闭 .btn 自带的 :active 固定中心涟漪，避免双响 ═══ */
.js .btn.btn-ripple::after{content:none!important;display:none!important}

/* ═══ 无障碍降级：系统级减少动画偏好 ═══ */
@media (prefers-reduced-motion: reduce){
  .js .reveal,.js .stagger>*,.js img.fade-load{opacity:1!important;transform:none!important;transition:none!important}
  .typing-dots i,.pulse-dot{animation:none!important}
  .list-item-in,.pop-in,.shake,.skeleton-fade{animation-duration:.01s!important}
}

/* ═══ quick-mode 兼容（!important 压制 .js 武装规则；.js 在 <html> 上是祖先，不可写作后代选择器） ═══ */
body.quick-mode .reveal,
body.quick-mode .stagger>*,
body.quick-mode img.fade-load{
  opacity:1!important;transform:none!important;transition:none!important}
body.quick-mode .typing-dots i,body.quick-mode .pulse-dot{animation:none!important}
body.quick-mode .tilt-hover:hover{transform:none!important}

/* ═══ 打印兜底：未触发动画的内容打印时强制可见 ═══ */
@media print{
  .js .reveal,.js .stagger>*,.js img.fade-load{opacity:1!important;transform:none!important}
}
